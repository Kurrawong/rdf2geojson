tern:hasAttribute prez:description "Link to an [Attribute](#Attribute)." ;
	prez:label "has attribute" .

tern:hasMethod prez:description "A property that links a concept to a method." ;
	prez:label "has method" .

tern:hasSimpleValue prez:label "has simple value" .

