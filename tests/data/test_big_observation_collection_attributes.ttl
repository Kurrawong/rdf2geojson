	tern:hasMethod emsa-cv:88068941-4dc9-4b44-bcfe-5eeeb3ba1a21 .

emsa-cv:19835fac-2edc-4960-89ad-7e5981dcc8f1 prez:description "A list of evidence/s indicating the presence of a taxa type in a project area.", "The observation method - tier 2 includes observations from physical signs (such as 'scats', 'diggings', 'feather', etc.) to human observations (such as 'spotlighting', 'acoustic recordings', et.) to imply the prescence of a taxa." ;
	prez:label "observation method - tier 2" .

emsa-cv:1b3904f4-df8c-49ba-a234-3b406fe11fa9 prez:description "A taxon (plural: taxa) is a group of organisms that are classified together based on their evolutionary relationships and shared characteristics.", "The broad taxon categories used here are Amphibian, Bird, Invertebrate, Mammal, Non-vascular plant, Reptile, and Vascular plant." ;
	prez:label "taxa type" .

emsa-cv:6b1b5d93-a0cf-47bc-959d-d9bdb6b8248b prez:description "A list of evidence/s indicating the presence of a taxa type in a project area.", "The observation method - tier 1 includes methods such as human observations like, 'seen' or 'heard'; or a physical 'sign'; or 'captured' method to imply the presence of a taxa." ;
	prez:label "observation method - tier 1" .

emsa-cv:6f6a3655-4347-4219-bfe1-9e4023d3a80f prez:description "A toggle field in the Monitor App to indicate the confidence of determining the species name in the field from an opportunistic observation." ;
	prez:label "species name - confidence" .

emsa-cv:f9874c91-f61d-5b74-90d1-aa71d3805b45 prez:description "Refers to the target taxa studied in a fauna survey. Warm-blooded vertebrates possessing feather and belonging to the class Aves." ;
	prez:label "Bird" .

