tern:Sampling prez:description "An activity of [Sampling](#Sampling) carries out a (Sampling) [Procedure](#Procedure) to create or transform one or more [Samples](#Sample)." ;
	prez:label "Sampling" .

tern:FeatureOfInterest prez:description "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
	prez:label "Feature of Interest" .

tern:ObservationCollection prez:description "Collection of one or more observations, whose members share a common value for one or more property" ;
	prez:label "Observation collection" .

<https://linked.data.gov.au/dataset/bdr/cfeb6552-abf6-4fc2-9fe1-d62f76c8579f/submission/81835916-fc22-4410-9b5c-953a6893b1ca/procedure/1b32d0eb-add6-4331-9059-bb2740d98970> prez:label "procedure" ;
	tern:hasMethod emsa-cv:bc2ba93e-43f9-425f-83cd-bbf5c422bdf8 .

tern-cv:2e122e23-881c-43fa-a921-a8745f016ceb prez:description "A plant specimen is a part of an individual plant or whole plant preserved, usually in a herbarium.", "Plant specimens usually are dried and mounted on a sheet of paper, but they may also be stored in boxes or kept in liquid preservatives. Plant specimens may be used for identification purposes, morphometrics, plant taxonomy and nomenclature, and the study of geographic distribution of plants." ;
	prez:label "plant specimen" .

tern-cv:633119a9-6c8a-46ae-a78a-23a4fd371eb2 prez:label "basis of record" .

tern:Sample prez:description "*A feature which is intended to be representative of a [FeatureOfInterest](http://w3.org/ns/sosa/FeatureOfInterest) on which [Observations](#Observation) may be made. Physical samples are sometimes known as physical specimens." ;
	prez:label "Sample" .

tern:Value prez:label "Value" .

tern:Attribute prez:description "A property-value pair. Same modelling pattern as [schema:PropertyValue](https://schema.org/PropertyValue)." ;
	prez:label "Attribute" .

geo:Feature prez:description "A discrete spatial phenomenon in a universe of discourse."@en ;
	prez:label "Feature"@en .

tern:Observation prez:description "Act of carrying out an (Observation) [Procedure](#Procedure) to estimate or calculate a value of a property of a [FeatureOfInterest](http://w3.org/ns/sosa/FeatureOfInterest). Links to a [Sensor](http://w3.org/ns/sosa/Sensor) to describe what made the [Observation](#Observation) and how; links to an [ObservableProperty](#ObservableProperty) to describe what the result is an estimate of, and to a [FeatureOfInterest](http://w3.org/ns/sosa/FeatureOfInterest) to detail what that property was associated with." ;
	prez:label "Observation" .

