emsa-cv:67c49fda-6ec2-4ec5-b84e-d04c3db2fd96 prez:description "The scanned barcode identification of the plant voucher specimen/s collected during an ecological survey." ;
	prez:label "voucher barcode" .

emsa-cv:b861c4b0-4846-428a-be90-bfd81d4cea5e prez:description "Plant habit is the the physical form and general appearence of a plant under the conditions of its environment." ;
	prez:label "plant habit" .

emsa-cv:dd1769b9-c475-4732-915c-9b890a8d5f65 prez:description "Plant growth forms can be defined as the physical form a plant assumes under the conditions of its environment." ;
	prez:label "growth form" .

tern:IRI prez:label "IRI" .

tern:Text prez:description "Class to encapsulate a textual value." ;
	prez:label "Text" .

<https://linked.data.gov.au/dataset/bdr/cfeb6552-abf6-4fc2-9fe1-d62f76c8579f/submission/0bb710c3-e924-4969-8a97-47964c46eb8b/procedure/fc32af9f-4137-4302-ac46-fafeacd0e9e6> prez:label "procedure" ;
	tern:hasMethod emsa-cv:bc2ba93e-43f9-425f-83cd-bbf5c422bdf8 .

emsa-cv:26f843a5-e1ed-46da-b22b-053e567e3227 prez:description "Taxon name determined during the process of field observation. A species is given two names in binomial nomenclature (e.g. Homo sapiens), the generic name and speciﬁc epithet (italicized in the scientiﬁc liter­ature), similar and related species being grouped into genera." ;
	prez:label "field species name" .

emsa-cv:33c1752f-b5f3-4ac9-9090-e9a4dd3096d1 prez:description "The timing of recurring climate or weather-driven plant biological changes (e.g., germination, budding, flowering, etc.), the causes of periodicity, the relationship with biotic (e.g. fruit availability) and abiotic (e.g. rain) drivers and the interrelations between the seasonal cycle of the same or different species." ;
	prez:label "phenological stage" .

time:Instant prez:description "A temporal entity with zero extent or duration"@en ;
	prez:label "Time instant"@en .

<https://linked.data.gov.au/dataset/bdr/cfeb6552-abf6-4fc2-9fe1-d62f76c8579f/submission/81835916-fc22-4410-9b5c-953a6893b1ca> prez:description "org minted uuid: 81835916-fc22-4410-9b5c-953a6893b1ca, application: https://staging.monitor.tern.org.au, version: 1.0.4+1-62d3a3bf, shape_file: https://github.com/ternaustralia/dawe-rlp-spec/tree/main/shapes/floristics/floristics-standard-protocol-shapes" ;
