@prefix geo: <http://www.opengis.net/ont/geosparql#> .

<camerons-corner> a geo:Feature ;
    geo:hasGeometry [ a geo:Geometry ;
            geo:asGeoJSON "{\"type\": \"Point\", \"meta\": {\"srid\": 4283}, \"coordinates\": [-28.991121, 141.00682]}"^^geo:geoJSONLiteral ;
            geo:asWKT "SRID=4283;POINT (141.0068200000000000 -28.9911210000000000)"^^geo:wktLiteral ] .

